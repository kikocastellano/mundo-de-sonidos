{
  "name": "mundo-de-sonidos",
  "private": true,
  "version": "0.1.0",
  "description": "App educativa para niños de 2 a 8 años: descubre animales del mundo y escucha sus sonidos",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/smoke.mjs",
    "assets": "node scripts/app-assets.mjs && npx @capacitor/assets@3 generate --android --iconBackgroundColor \"#6fc0ff\" --splashBackgroundColor \"#d9f1ff\"",
    "store:shots": "npm run build && node scripts/store-shots.mjs && node scripts/store-marketing.mjs",
    "promo": "npm run build && node scripts/promo-video.mjs",
    "android": "npm run build && cap sync android && cap open android",
    "cap:sync": "npm run build && cap sync",
    "test:licenses": "node tests/licenses.mjs",
    "sounds:fetch": "node scripts/fetch-sounds.mjs",
    "sounds:process": "node scripts/process-sounds.mjs && node tests/licenses.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "playwright": "1.56.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "cordova-plugin-purchase": "^13.19.1"
  }
}
